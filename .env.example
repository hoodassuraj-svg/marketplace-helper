# .env.example  --  copy to ".env" and edit only if you want to override defaults.
#
#     cp .env.example .env
#
# IMPORTANT: Facebook credentials are intentionally NOT stored here.
# You log into Facebook by hand once in the browser window; the session is
# saved in the profile folder below and reused automatically every run after.
# This avoids the scripted-login pattern that gets accounts flagged/banned.

# Where your Facebook login session is stored (keep this private).
FB_PROFILE_DIR=./.fb_profile

# Keep the browser visible so you can review the form and click Publish.
# Set to true only if you know you want it hidden (not recommended for posting).
HEADLESS=false
